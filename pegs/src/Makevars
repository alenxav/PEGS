# These variables will be set by the configure script on non-Windows
# On Windows, R automatically provides a compatible compiler, so -fopenmp is safe
CXX_OPENMP_FLAGS = -fopenmp
LIBS_OPENMP_FLAGS = -fopenmp

# Use the variables to set the final flags
PKG_CXXFLAGS = $(CXX_OPENMP_FLAGS)
PKG_LIBS = $(LIBS_OPENMP_FLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)