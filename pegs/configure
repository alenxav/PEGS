#!/bin/sh

# Get the C++ compiler from R's configuration
CXX="`"${R_HOME}/bin/R" CMD config CXX`"

# Write a small test program
cat > conftest.cpp <<EOF
#include <omp.h>
int main() {
  #pragma omp parallel
  return 0;
}
EOF

# Check if the compiler supports -fopenmp by trying to compile the test program
if ${CXX} -fopenmp conftest.cpp -o conftest >/dev/null 2>&1; then
  # If it works, create a Makevars file in src/ with the flags
  echo "PKG_CXXFLAGS += -fopenmp" > src/Makevars
  echo "PKG_LIBS += -fopenmp" >> src/Makevars
fi

# Clean up the test files
rm -f conftest.cpp conftest

exit 0
